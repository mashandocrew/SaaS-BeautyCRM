# Copiar a apps/web/.env.local y completar con los valores reales del
# proyecto Supabase (Project Settings → API). NUNCA versionar .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo server-side. JAMÁS exponer al cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Invitar operadoras por WhatsApp (Meta WhatsApp Cloud API). Opcional: si
# faltan, el canal "Email" del wizard sigue funcionando igual, y el canal
# "WhatsApp" devuelve un error explicando que falta configurarlo.
# - WHATSAPP_CLOUD_API_TOKEN: token del System User en Meta Business Manager.
# - WHATSAPP_PHONE_NUMBER_ID: ID del número de WhatsApp Business habilitado.
# - WHATSAPP_INVITE_TEMPLATE_NAME: nombre de la plantilla pre-aprobada por
#   Meta para el mensaje de invitación (2 variables: nombre y link).
# - WHATSAPP_INVITE_TEMPLATE_LANG: código de idioma de la plantilla (default "es").
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_INVITE_TEMPLATE_NAME=
WHATSAPP_INVITE_TEMPLATE_LANG=es
