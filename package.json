{
  "name": "beautycrm",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @beautycrm/web dev",
    "build": "pnpm --filter @beautycrm/web build",
    "lint": "pnpm -r --if-present run lint",
    "test:e2e": "pnpm --filter @beautycrm/web test:e2e",
    "test:security": "pnpm --filter @beautycrm/web test:security",
    "test:agenda": "pnpm --filter @beautycrm/web test:agenda",
    "test:clientes": "pnpm --filter @beautycrm/web test:clientes",
    "test:servicios": "pnpm --filter @beautycrm/web test:servicios",
    "test:inventario": "pnpm --filter @beautycrm/web test:inventario",
    "test:caja": "pnpm --filter @beautycrm/web test:caja",
    "test:comisiones": "pnpm --filter @beautycrm/web test:comisiones",
    "test:reportes": "pnpm --filter @beautycrm/web test:reportes",
    "types:generate": "supabase gen types typescript --project-id xhbrhpfzehshiyjzlxnx --schema public > packages/supabase/src/types.ts"
  }
}
